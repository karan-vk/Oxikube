{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "worker-5",
    "namespace": "fxrun-data",
    "labels": {
      "app.kubernetes.io/part-of": "apply-fixture"
    }
  },
  "spec": {
    "replicas": 0,
    "selector": {
      "matchLabels": {
        "app": "worker-5"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "worker-5"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "worker",
            "image": "busybox:1.36",
            "command": [
              "sleep",
              "3600"
            ]
          }
        ]
      }
    }
  }
}
