    "ThemeContent": {
      "description": "One entry of `themes`.",
      "properties": {
        "appearance": {
          "$ref": "#/$defs/AppearanceContent",
          "description": "Whether the theme is light or dark."
        },
        "name": {
          "description": "Theme name, shown in the picker and used by the `theme` setting.",
          "type": "string"
        },
        "oxikube": {
          "anyOf": [
            {
              "$ref": "#/$defs/OxikubeContent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Oxikube's own Kubernetes status colours (optional; derived from `style` when absent)."
        },
        "style": {
          "$ref": "#/$defs/ThemeStyleContent",
          "default": {},
          "description": "Colours keyed by dotted Zed key (`editor.background`), plus `players`, `accents` and\n`syntax`."
        }
      },
      "required": [
        "name",
        "appearance"
      ],
      "type": "object"
    },
