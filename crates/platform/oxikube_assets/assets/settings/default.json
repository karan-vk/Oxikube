// Oxikube default settings.
//
// Do not edit this file: it is embedded in the binary. Copy the settings you want to change
// into your user settings.json (`$OXIKUBE_CONFIG_DIR/settings.json`, or
// `~/.config/oxikube/settings.json`) and edit them there. User values override these defaults,
// and `"clusters": { "<cluster id>": { ... } }` overrides both for one cluster.
//
// Every setting a crate registers has its default here (and a schema entry in
// settings.schema.json, regenerated with `cargo xtask gen-settings-schema`).
{
  // Colour theme: a theme name ("Ayu Dark"), or a mode with a light and a dark theme.
  // `mode` is "system" (follow the OS appearance), "light" or "dark". Themes are Zed
  // theme-family JSON: One Dark and One Light are built in; drop more into the `themes/`
  // folder next to settings.json and they are picked up without a restart.
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  // UI zoom factor, 1.0 = 100 %. Clamped to 0.5 - 3.0. cmd/ctrl + and - and 0 change it and
  // write it back here.
  "ui_scale": 1.0,
  // Reduced motion: "system" follows the OS preference, "on" or "off" overrides it.
  "reduce_motion": "system",
  // Ask before quitting while exec sessions, port-forwards or applies are running.
  "confirm_quit": true,
  // Log filter, `RUST_LOG` syntax. Logs go to rolling files in `<data dir>/oxikube/logs`
  // (daily, seven kept) with secrets redacted; a `RUST_LOG` set at launch wins for that run.
  // Keep hyper, h2, tower and rustls at `warn`: at debug and trace they log request headers.
  "log": {
    "filter": "info,hyper=warn,hyper_util=warn,h2=warn,tower=warn,tower_http=warn,rustls=warn"
  },
  // Where Oxikube reads kubeconfigs from, in order (the first definition of a context name wins):
  //   { "kind": "default" }                 what kubectl reads: $KUBECONFIG, else ~/.kube/config
  //   { "kind": "file", "path": "/a/b.yaml" }  one kubeconfig file, read in place
  //   { "kind": "dir", "path": "~/clusters" }  the files directly inside a folder
  // A leading ~ is your home directory. Your list replaces this one, so keep the "default" entry
  // to keep reading kubectl's files. The Kubeconfig sources screen edits this list (pasted
  // kubeconfigs are stored under <config dir>/kubeconfigs and listed here as files). Paths only:
  // never put a token or key in this file.
  "kubeconfig": {
    "sources": [{ "kind": "default" }]
  },
  // Session restore: reopen the clusters, tabs and namespaces of your last session at launch.
  // Off by default. Restoring starts after the window is drawn, so it never delays start-up, and a
  // cluster that fails or cannot be reached only shows an error in its own tab.
  "session": {
    // `true` reopens the saved cluster tabs (clusters no kubeconfig defines any more are dropped,
    // with a notice).
    "restore": false,
    // Which restored clusters connect at launch: "active" (the cluster whose tab was displayed;
    // the others connect when you open their tab) or "all" (the displayed one first, then two at
    // a time).
    "restore_connect": "active"
  },
  // Resource tables (E07-S04).
  "resource_table": {
    // Remember the filter typed in each kind's table (the `/` bar) and restore it the next time
    // that table opens. Off by default: a filter you forgot about is a table that looks empty.
    // Saved per kind, not per cluster; only the text you typed is kept.
    "persist_filter": false
  },
  // Logs (E08-S01).
  "logs": {
    // Lines each log session keeps in memory (100 to 5,000,000). When a chatty pod writes more,
    // the oldest lines are dropped and the viewer shows a "truncated" marker above the first one.
    // A change applies to the sessions that are open at once.
    "buffer_lines": 50000
  },
  // The Describe tab of a resource's detail (`kubectl describe`-style text). `backend`:
  //   "auto"     render in process (deskribe: 36 specialised kinds, a generic layout for custom
  //              resources), and run the `kubectl` binary for a kind deskribe does not cover
  //   "native"   deskribe only, never run kubectl
  //   "kubectl"  always run `kubectl describe`
  // `kubectl_path`: the binary to run; null looks `kubectl` up on PATH. A change applies to the
  // next describe.
  "describe": {
    "backend": "auto",
    "kubectl_path": null
  },
  // Local terminals (E09). `shell`: the program a terminal runs; null uses $SHELL, then /bin/sh.
  // `shell_args`: its arguments, e.g. ["-l"] for a login shell (off by default: a login shell
  // re-reads your profile and slows opening a terminal). A cluster's terminal starts with
  // KUBECONFIG (a private merged file holding only that cluster's context, removed when the
  // terminal closes), KUBE_CONTEXT and OXIKUBE_NAMESPACE set; PATH is yours, untouched. Note that
  // kubectl in the shell is not behind Oxikube's read-only mode or confirmations. Applies to
  // terminals opened afterwards.
  "terminal": {
    "shell": null,
    "shell_args": []
  },
  // Per-cluster settings. Each key below is a default for every cluster; write the same key under
  // `clusters.<id>` (below) to override it for one cluster. Layers merge field by field:
  // this file, then your top-level values, then the cluster's own.
  //
  // A name to show instead of the kubeconfig context name (useful under `clusters.<id>`).
  "display_name": null,
  // Accent colour of the cluster's tab, hotbar dot and badges: "#rrggbb" or "#rgb".
  "colour": null,
  // Block every mutation. Set `true` under `clusters.<id>` to protect one cluster, or at the top
  // level to start every cluster read-only and opt individual ones out with `false`.
  "read_only": false,
  // The namespace a new session starts in; null uses the kubeconfig context's namespace.
  "default_namespace": null,
  // Working directory of terminals opened for the cluster; null uses your home directory.
  "terminal_cwd": null,
  // Image and image pull Secret (a Kubernetes Secret name, not a credential) of the node shell
  // pod; null uses the built-in image.
  "node_shell_image": null,
  "node_shell_pull_secret": null,
  // Manual Prometheus location instead of auto-detection, e.g.
  // { "url": "https://prometheus.example.com", "auth_secret": "prod-prometheus" }.
  // `auth_secret` names an OS keychain entry (namespace `prometheus`) holding the bearer token;
  // never put a token in this file.
  "prometheus": null,
  // Namespaces to offer when you may not list namespaces cluster-wide (RBAC-restricted users).
  "accessible_namespaces": [],
  // How interactive exec credential plugins (aws, gke-gcloud-auth-plugin, ...) may be: "never"
  // (no stdin, no prompts), "if_available" or "always". Read when a session connects, so a change
  // applies on the next connect.
  "exec_interactivity": "never",
  // Per-cluster overrides, keyed by cluster id (16 hex characters; the catalog shows it). Each
  // value takes the per-cluster settings above and any other setting. Edits apply at once, except
  // `exec_interactivity` (next connect) and `default_namespace` (new sessions). Example:
  //
  //   "clusters": {
  //     "3f2a9c1b7d4e8a60": {
  //       "display_name": "Production (eu-west)",
  //       "colour": "#e5484d",
  //       "read_only": true
  //     }
  //   }
  "clusters": {}
}
