// Oxikube default settings.
//
// Do not edit this file: it is embedded in the binary. Copy the settings you want to change
// into your user settings.json (`$OXIKUBE_CONFIG_DIR/settings.json`, or
// `~/.config/oxikube/settings.json`) and edit them there. User values override these defaults,
// and `"clusters": { "<cluster id>": { ... } }` overrides both for one cluster.
//
// Every setting a crate registers has its default here (and a schema entry in
// settings.schema.json, regenerated with `cargo xtask gen-settings-schema`).
{
  // Colour theme: a theme name ("Ayu Dark"), or a mode with a light and a dark theme.
  // `mode` is "system" (follow the OS appearance), "light" or "dark". Themes are Zed
  // theme-family JSON: One Dark and One Light are built in; drop more into the `themes/`
  // folder next to settings.json and they are picked up without a restart.
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  // UI zoom factor, 1.0 = 100 %. Clamped to 0.5 - 3.0. cmd/ctrl + and - and 0 change it and
  // write it back here.
  "ui_scale": 1.0,
  // Reduced motion: "system" follows the OS preference, "on" or "off" overrides it.
  "reduce_motion": "system",
  // Ask before quitting while exec sessions, port-forwards or applies are running.
  "confirm_quit": true,
  // The keymap layered under your keymap.json: "default" (the per-OS defaults) or "vim". "vim"
  // adds j/k, gg/G, ctrl-d/ctrl-u (half a page), / (filter), : (jump bar), dd (delete, with the
  // usual confirmation) and yy (copy the name) to resource tables, and moves describe/YAML from
  // d/y to gd/gy. Text fields, the terminal and the manifest editor are not changed. Switching
  // takes effect at once.
  "base_keymap": "default",
  // Log filter, `RUST_LOG` syntax. Logs go to rolling files in `<data dir>/oxikube/logs`
  // (daily, seven kept) with secrets redacted; a `RUST_LOG` set at launch wins for that run.
  // Keep hyper, h2, tower and rustls at `warn`: at debug and trace they log request headers.
  "log": {
    "filter": "info,hyper=warn,hyper_util=warn,h2=warn,tower=warn,tower_http=warn,rustls=warn"
  },
  // Where Oxikube reads kubeconfigs from, in order (the first definition of a context name wins):
  //   { "kind": "default" }                 what kubectl reads: $KUBECONFIG, else ~/.kube/config
  //   { "kind": "file", "path": "/a/b.yaml" }  one kubeconfig file, read in place
  //   { "kind": "dir", "path": "~/clusters" }  the files directly inside a folder
  // A leading ~ is your home directory. Your list replaces this one, so keep the "default" entry
  // to keep reading kubectl's files. The Kubeconfig sources screen edits this list (pasted
  // kubeconfigs are stored under <config dir>/kubeconfigs and listed here as files). Paths only:
  // never put a token or key in this file.
  "kubeconfig": {
    "sources": [{ "kind": "default" }]
  },
  // Metrics and utilisation (E13). Every key can also be set under "clusters.<id>.metrics".
  //   gpu_vendors   the extended resource names counted as GPUs in the requests, limits and
  //                 allocation figures of pods, nodes and namespaces. A GPU is a whole-number
  //                 count, summed per name. Your list replaces this one (an empty list turns GPU
  //                 accounting off); list a MIG profile or a vendor of your own by its exact
  //                 resource name. Edits apply at once.
  //   poll_interval_secs  how often live CPU and memory are read from metrics-server while a
  //                 Pods or Nodes table (or a pod's containers) is on screen; nothing is polled
  //                 for a hidden tab. 5 to 600; after errors the interval doubles (up to two
  //                 minutes), and a cluster without metrics-server is asked every five minutes.
  //   thresholds    k9s' thresholds: the percent of a limit (pods, containers) or of a node's
  //                 allocatable at which a usage cell turns amber (`warn`) and red (`critical`).
  //   history_refresh_secs  how often a shown Metrics tab of a detail panel (Pod, Node,
  //                 Deployment and other workloads, Namespace, PVC, Ingress) asks Prometheus
  //                 again, 10 to 300. Nothing is asked while the tab is not shown. Edits apply
  //                 at once. The 15m / 1h / 6h / 24h range is remembered from your last choice.
  "metrics": {
    "gpu_vendors": ["nvidia.com/gpu", "amd.com/gpu", "gpu.intel.com/i915", "gpu.intel.com/xe"],
    "poll_interval_secs": 15,
    "history_refresh_secs": 30,
    "thresholds": {
      "cpu": { "warn": 70, "critical": 90 },
      "memory": { "warn": 70, "critical": 90 }
    }
  },
  // Port-forwards (E15-S08). Also valid under `clusters.<id>.portforward` for one cluster. Edits
  // apply to forwards started afterwards; running forwards are left alone.
  //   default_bind  the IP address a forward listens on unless asked otherwise. Loopback keeps the
  //                 forwarded port private to this machine; any other address exposes it to the
  //                 network.
  //   allowed_in_readonly  let forwards start on a read-only cluster (they change nothing in the
  //                 cluster, but the default is strict).
  //   port_range    `[first, last]`: the unprivileged local ports a forward that asks for a free
  //                 port picks from, for example [20000, 40000]. Not set: the OS picks.
  //   annotations   read the k9s `k9scli.io/port-forwards` / `auto-port-forwards` pod
  //                 annotations as start-dialog suggestions (opt-in; read only, Oxikube never
  //                 writes annotations).
  "portforward": {
    "default_bind": "127.0.0.1",
    "allowed_in_readonly": false,
    "annotations": false
  },
  // Helm (E16-S11). Global: the binary and the repositories belong to this machine. Edits apply
  // at once; changing `path` runs Helm detection again, no restart needed.
  //   path          the `helm` binary. Empty autodetects (PATH, then the usual install
  //                 directories). Without Helm 3.10 or newer, releases, history, values, manifests
  //                 and notes still work; install, upgrade, rollback, uninstall and the charts
  //                 catalog are hidden until a binary is found.
  //   server_side_apply  pass `--server-side` on install and upgrade (needs Helm 3.13 or newer;
  //                 a warning shows when the binary is older).
  //   default_repos the chart repositories offered in Helm > Repositories, each `{ name, url }`
  //                 with an http(s) URL and no credentials in it.
  "helm": {
    "path": "",
    "server_side_apply": false,
    "default_repos": [
      { "name": "bitnami", "url": "https://charts.bitnami.com/bitnami" },
      { "name": "ingress-nginx", "url": "https://kubernetes.github.io/ingress-nginx" },
      { "name": "prometheus-community", "url": "https://prometheus-community.github.io/helm-charts" }
    ]
  },
  // Cloud discovery (E18): the Cloud section of the catalog finds EKS, GKE and AKS clusters through
  // the aws, gcloud and az CLIs you already use. Global; edits apply to the next refresh, and a
  // provider switched off disappears at once, no restart. Nothing here holds a credential.
  //   providers     which providers run: "aws", "gcloud", "az" (an unknown id is reported)
  //   *_path        where a CLI is; empty looks it up (login shell PATH, app PATH, the usual
  //                 install directories). `gke_gcloud_auth_plugin_path` and `kubelogin_path`
  //                 locate the exec plugins GKE and AKS contexts run
  //   aws.profiles  profiles to scan; EMPTY = every profile `aws configure list-profiles` reports
  //   aws.regions   regions to scan in each profile besides its default region; EMPTY = none extra
  //   gcloud.projects  project ids to scan; EMPTY = every project (slow on big organisations)
  //   az.subscriptions  subscription ids or names to scan; EMPTY = every enabled subscription
  //   cache_ttl_secs  how long a listing stays fresh (30 to 86400)
  //   parallelism   scopes and CLI processes at once (1 to 16)
  //   command_timeout_secs  how long one CLI command may run (5 to 600)
  "cloud": {
    "providers": { "aws": true, "gcloud": true, "az": true },
    "aws_path": "",
    "gcloud_path": "",
    "az_path": "",
    "gke_gcloud_auth_plugin_path": "",
    "kubelogin_path": "",
    "aws": { "profiles": [], "regions": [] },
    "gcloud": { "projects": [] },
    "az": { "subscriptions": [] },
    "cache_ttl_secs": 900,
    "parallelism": 4,
    "command_timeout_secs": 30
  },
  // Session restore: reopen the clusters, tabs and namespaces of your last session at launch.
  // Off by default. Restoring starts after the window is drawn, so it never delays start-up, and a
  // cluster that fails or cannot be reached only shows an error in its own tab.
  "session": {
    // `true` reopens the saved cluster tabs (clusters no kubeconfig defines any more are dropped,
    // with a notice).
    "restore": false,
    // Which restored clusters connect at launch: "active" (the cluster whose tab was displayed;
    // the others connect when you open their tab) or "all" (the displayed one first, then two at
    // a time).
    "restore_connect": "active"
  },
  // Resource tables (E07-S04, E11-S06).
  "resource_table": {
    // Remember the filter typed in each table (the `/` bar) and restore it the next time that
    // table opens. On by default; a filter in effect shows as a chip with a cross next to the
    // bar, `escape` in the bar clears it, and clearing it forgets it. Saved per cluster and kind;
    // only the text you typed is kept.
    "persist_filter": true
  },
  // Logs (E08-S01, E08-S10). Every key can also be set under "clusters.<id>.logs" (a chatty
  // production cluster may want a bigger buffer). Numbers out of range are clamped (a warning
  // goes to the log), never refused.
  //   buffer_lines      lines each log session keeps in memory (100 to 5,000,000). When a chatty
  //                     pod writes more, the oldest lines are dropped and the viewer shows a
  //                     "truncated" marker above the first one. Applies to open sessions at once.
  //   default_tail      lines the tail range (key 0) reads before it follows (1 to 100,000).
  //                     Applies to log views opened afterwards.
  //   wrap              wrap long lines instead of letting them run off the edge (key w toggles
  //                     it for one view). Applies to open views at once.
  //   timestamps        show each line's server timestamp before its text (key t toggles it for
  //                     one view). Applies to open views at once.
  //   max_streams       containers a multi-pod log (a Deployment, StatefulSet, DaemonSet, Job or
  //                     Service) reads at once (1 to 200). When more match, the first are read in
  //                     name order and the view says how many pods were left out. Applies to
  //                     open views at once.
  //   json_auto_detect  JSON mode: lines that are JSON objects show as level / time / message
  //                     columns with the other fields collapsed (click to expand), with level
  //                     chips; plain-text lines stay as they are (key j toggles it for one view).
  //                     Applies to open views at once.
  //   reconnect_retries times in a row a log stream that broke while its pod runs (a dropped
  //                     connection, an API server timeout) is reopened, after a pause that
  //                     doubles each time, before the view shows it failed (0 to 50; 0 never
  //                     reconnects). The overlap is never shown twice; a failed view reconnects
  //                     with key r. Applies to open views at once.
  // The keys of the log view are in the keymap (context "LogView"); rebind them in keymap.json.
  "logs": {
    "buffer_lines": 50000,
    "default_tail": 1000,
    "wrap": false,
    "timestamps": false,
    "json_auto_detect": true,
    "max_streams": 20,
    "reconnect_retries": 5
  },
  // Kubernetes events and the notifications raised from them (E14). Can also be set under
  // "clusters.<id>.events" (buffer, watched_kinds, ignore_reasons, os_notifications). A number or
  // duration out of range is clamped and a duration that does not parse falls back to its
  // default (a warning goes to the log), never refused; a value of the wrong type is reported as
  // a settings diagnostic and the block keeps its last good (or default) values.
  //   buffer   events each cluster keeps in memory, newest by last seen (100 to 50,000); older
  //            ones are dropped. 10,000 events hold about 17 MB. One events watch per cluster
  //            feeds the events view, a resource's Events tab, the warning badges, the
  //            notifications and the overview's warnings. Applies at once (a smaller value drops
  //            the oldest events).
  //   warning_window  how long a Warning event keeps its object's warning icon in the tables
  //            and stays in the overviews' recent warnings: a number and m, h or d (30m, 1h, 2d;
  //            1 minute to 7 days). Applies at once, to every cluster (a per-cluster value is not
  //            read).
  //   os_notifications  also show Warning notifications on the desktop (macOS notification
  //                 centre, Linux D-Bus notifications). Off by default; turning it on asks the OS for
  //                 permission where it has such a thing, and is the only time Oxikube contacts the
  //                 notification service. Clicking a notification brings Oxikube to the front and
  //                 opens the object. Also available as the "Toggle OS Notifications" command;
  //                 "Send Test OS Notification" checks that they reach you. A development build
  //                 run outside an .app bundle may not be allowed to notify by the OS. Under
  //                 "clusters.<id>.events", false keeps that cluster off the desktop (it still
  //                 toasts in the app); true cannot switch the desktop on for one cluster.
  //   watched_kinds  the kinds whose Warning events notify: a toast, a row in the notification
  //            centre and, with os_notifications on, a desktop notification. Case does not
  //            matter, at most 64; [] notifies about nothing. Applies at once.
  //   ignore_reasons  reasons that never notify, whatever the kind (matched exactly: "BackOff",
  //            "Unhealthy"). At most 256. Applies at once.
  //   rate_limit  keeps a burst from becoming spam (one per app, applies at once):
  //     per_object    one object's notification toasts at most this often; more occurrences
  //                   only count up its row (s, m, h or d: 5m; 1 second to 1 day)
  //     per_reason    objects of one reason in one cluster that get a notification of their own
  //                   within group_window before the rest fold into one "12 pods: BackOff" row
  //                   (1 to 100)
  //     group_window  the window per_reason counts in (1 second to 1 hour)
  //     max_raised    notifications that may toast per raise_window, whatever their reasons;
  //                   the others are only listed in the centre (1 to 100)
  //     raise_window  the window max_raised counts in (1 second to 1 hour)
  "events": {
    "buffer": 10000,
    "os_notifications": false,
    "watched_kinds": [
      "Pod",
      "Deployment",
      "StatefulSet",
      "DaemonSet",
      "ReplicaSet",
      "Job",
      "CronJob",
      "Node",
      "PersistentVolumeClaim"
    ],
    "ignore_reasons": [],
    "rate_limit": {
      "per_object": "5m",
      "per_reason": 3,
      "group_window": "1m",
      "max_raised": 5,
      "raise_window": "30s"
    },
    "warning_window": "1h"
  },
  // The Describe tab of a resource's detail (`kubectl describe`-style text). `backend`:
  //   "auto"     render in process (deskribe: 36 specialised kinds, a generic layout for custom
  //              resources), and run the `kubectl` binary for a kind deskribe does not cover
  //   "native"   deskribe only, never run kubectl
  //   "kubectl"  always run `kubectl describe`
  // `kubectl_path`: the binary to run; null looks `kubectl` up on PATH. A change applies to the
  // next describe.
  "describe": {
    "backend": "auto",
    "kubectl_path": null
  },
  // Local terminals (E09). `shell`: the program a terminal runs; null uses $SHELL, then /bin/sh.
  // `shell_args`: its arguments, e.g. ["-l"] for a login shell (off by default: a login shell
  // re-reads your profile and slows opening a terminal). A cluster's terminal starts with
  // KUBECONFIG (a private merged file holding only that cluster's context, removed when the
  // terminal closes), KUBE_CONTEXT and OXIKUBE_NAMESPACE set; PATH is yours, untouched. Note that
  // kubectl in the shell is not behind Oxikube's read-only mode or confirmations. A new shell
  // applies to terminals opened afterwards; a running one keeps its shell. `shell` and
  // `shell_args` can also be set under `clusters.<id>.terminal` for one cluster's terminals; the
  // other keys are read from this block only.
  "terminal": {
    "shell": null,
    "shell_args": [],
    // Font of the terminal text. null: the platform's monospace font (Menlo, Consolas, DejaVu
    // Sans Mono) at the theme's monospace size. font_size is in points (6 - 72), line_height a
    // multiple of it (1.0 - 2.5); values outside are clamped. Changes repaint open terminals.
    "font_family": null,
    "font_size": null,
    "line_height": 1.3,
    // The cursor until the process sets its own: "block", "bar" or "underline"; cursor_blink
    // makes it blink.
    "cursor_shape": "block",
    "cursor_blink": false,
    // What a bell from the process does: "none", "visual" (a brief flash) or "audible" (the
    // system alert sound).
    "bell": "visual",
    // Lines of history each terminal keeps in memory (0 - 100000). Scrollback is never saved to
    // disk. A change applies to open terminals at once (a smaller value drops the oldest lines).
    "scrollback_lines": 10000,
    // Copy the selection to the clipboard when the mouse button is released. cmd-c (ctrl-shift-c
    // on Linux and Windows) always copies it; ctrl-c always interrupts the process.
    "copy_on_select": false,
    // Alt (Option) sends ESC before the key ("meta": alt-b, alt-f, alt-. in shells and editors).
    // null: off on macOS, where Option types characters, on elsewhere.
    "option_as_meta": null,
    // Ask before pasting text with more than one line (a pasted newline runs the line).
    "confirm_multiline_paste": true,
    // The shells `pod: shell` tries in a container, first to last (each probed with a quick exec;
    // the first the container has is opened and named in a line at the top of the terminal).
    // A name or an absolute path. Empty uses the default. Applies to shells opened afterwards.
    "exec_shells": ["bash", "sh"]
  },
  // The manifest editor (E10-S12). Every key can also be set under "clusters.<id>.editor" (a
  // cluster that already uses another field manager name, say). A value out of range or of the
  // wrong type is replaced by the default for that key alone, with a notice.
  //   tab_size             spaces one indent is: the tab key, indent and outdent (1 to 16).
  //                        Applies to open editors at once; the text and undo history stay.
  //   font_family          the font of the text; null uses the theme's monospace font. Applies to
  //                        open editors at once.
  //   font_size            points at 100 % UI zoom (6 to 72; the zoom scales it like every other
  //                        size); null uses the theme's monospace size. Applies at once.
  //   soft_wrap            wrap long lines at the editor's width instead of scrolling sideways.
  //                        Applies at once to open editors (the editor's Wrap toggle changes one
  //                        editor only).
  //   show_managed_fields  keep metadata.managedFields in the text of a live object you open.
  //   mask_secrets         show the values of a Secret's data as ******** when you open it. With
  //                        false the values show in the editor, in memory only: decoded Secret data
  //                        is never written to disk, logs or the audit trail, whatever this says.
  //   validation           check the manifest against the cluster's schemas as you type. Turning it
  //                        off clears the squiggles; on checks every open editor at once.
  //   field_manager        the name server-side apply records for the fields you set: 1 to 128
  //                        characters, no whitespace; invalid is replaced by "oxikube". Applies to
  //                        the next apply.
  "editor": {
    "tab_size": 2,
    "font_family": null,
    "font_size": null,
    "soft_wrap": false,
    "show_managed_fields": false,
    "mask_secrets": true,
    "validation": true,
    "field_manager": "oxikube"
  },
  // Per-cluster settings. Each key below is a default for every cluster; write the same key under
  // `clusters.<id>` (below) to override it for one cluster. Layers merge field by field:
  // this file, then your top-level values, then the cluster's own.
  //
  // A name to show instead of the kubeconfig context name (useful under `clusters.<id>`).
  "display_name": null,
  // Accent colour of the cluster's tab, hotbar dot and badges: "#rrggbb" or "#rgb".
  "colour": null,
  // Block every mutation. Set `true` under `clusters.<id>` to protect one cluster, or at the top
  // level to start every cluster read-only and opt individual ones out with `false`.
  "read_only": false,
  // The namespace a new session starts in; null uses the kubeconfig context's namespace.
  "default_namespace": null,
  // Working directory of terminals opened for the cluster; null uses your home directory.
  "terminal_cwd": null,
  // The node shell (`node: shell`) runs in a short-lived privileged pod pinned to the node and
  // deleted when the terminal closes. Its image needs `nsenter` and `sleep`; the image pull Secret
  // is a Kubernetes Secret name in the pod's namespace, not a credential.
  "node_shell_image": "busybox:1.37",
  "node_shell_pull_secret": null,
  // The rest of the pod template. Fields merge across layers; a list replaces the one above it.
  //   namespace: where the pod lives. kube-system exists everywhere and is exempt from the pod
  //     security admission that refuses privileged pods in ordinary namespaces.
  //   command: what runs in the node's namespaces; [] runs `bash -l` if the node has bash, else
  //     `sh -l`.
  //   nsenter_args: the nsenter options before `--` (enter every namespace of the node's init).
  //   tolerations: what the pod tolerates; the default tolerates every taint, [] tolerates none.
  //   labels: added to the pod (Oxikube's own labels cannot be replaced).
  //   image_pull_policy: "Always", "IfNotPresent" or "Never"; null leaves the cluster's default.
  //   max_lifetime_seconds: the cluster deletes the pod after this long if Oxikube could not.
  "node_shell": {
    "namespace": "kube-system",
    "command": [],
    "nsenter_args": ["-t", "1", "-m", "-u", "-i", "-n", "-p"],
    "tolerations": [{ "operator": "Exists" }],
    "labels": {},
    "image_pull_policy": null,
    "max_lifetime_seconds": 28800
  },
  // History metrics (graphs), per cluster: set any of these at the top level for every cluster or
  // under `clusters.<id>.prometheus` for one. Live CPU/memory from metrics-server is separate and
  // never affected by this block. Fields merge across layers; edits apply at once.
  //   enabled      false fetches no history metrics for the cluster, whatever `provider` says.
  //   provider     "auto" probes the cluster for a Prometheus-compatible service when it connects
  //                (kube-prometheus, Lens stack, VictoriaMetrics, Mimir, OpenShift) through the
  //                API server's service proxy; "manual" uses `url` or `path`; "off" fetches
  //                nothing. null means "manual" when `url` or `path` is set, else "auto".
  //   kind         manual only: "kube_prometheus", "lens", "victoria_metrics", "mimir",
  //                "openshift" or "prometheus" (null), so history queries use the right labels.
  //   url          manual: a direct http(s) URL, no credentials, e.g. "https://vm.example.com".
  //   path         manual: "namespace/service:port" through the API server with your cluster
  //                credentials, e.g. "monitoring/vmsingle-vmks:8429".
  //   path_prefix  inserted before /api/v1/..., e.g. "/prometheus" (Mimir) or
  //                "/select/0/prometheus" (VictoriaMetrics cluster).
  //   auth         for a `url`: "none", "bearer" or "basic". null means "bearer" when
  //                `auth_secret` is set ("basic" when `auth_user` is too), else "none".
  //   auth_user    the user name of basic auth.
  //   auth_secret  the name of an OS keychain entry (namespace `prometheus`) holding the bearer
  //                token or the basic password; never put a token in this file.
  // The cluster settings page of a connected cluster shows what detection found and which
  // services it probed, and can run it again.
  "prometheus": {
    "enabled": true,
    "provider": null,
    "kind": null,
    "url": null,
    "path": null,
    "path_prefix": null,
    "auth": null,
    "auth_user": null,
    "auth_secret": null
  },
  // Namespaces to offer when you may not list namespaces cluster-wide (RBAC-restricted users).
  "accessible_namespaces": [],
  // How interactive exec credential plugins (aws, gke-gcloud-auth-plugin, ...) may be: "never"
  // (no stdin, no prompts), "if_available" or "always". Read when a session connects, so a change
  // applies on the next connect.
  "exec_interactivity": "never",
  // Allow a shell, attach or exec into a pod (pod::Shell, pod::Attach) while `read_only` is on. A
  // shell can change anything the container's user can, so a read-only cluster blocks it unless
  // you set this to true, at the top level or under `clusters.<id>`. Applies at once.
  "exec_in_read_only": false,
  // The watch budget: limits on the live feeds (tables, sidebar counts, detail views, log
  // targets) the app keeps open on a cluster, so a very large cluster cannot exhaust memory.
  //   max_feeds: feeds open at once (each namespace of a multi-namespace selection is one).
  //   max_objects: no new feed opens while the open feeds hold this many objects.
  //   metadata_above: past this many objects, kinds that would get whole objects get
  //     metadata-only feeds (names, labels, ages) instead.
  //   idle_grace_seconds: how long a feed of a closed view keeps running, so going back is
  //     instant; at the limit such feeds are closed first.
  // Fields merge across layers; a change applies to the next feed opened, without reconnecting.
  // `oxikube --perf` prints each connected cluster's counters on exit.
  "watch_budget": {
    "max_feeds": 64,
    "max_objects": 100000,
    "metadata_above": 25000,
    "idle_grace_seconds": 30
  },
  // Per-cluster overrides, keyed by cluster id (16 hex characters; the catalog shows it). Each
  // value takes the per-cluster settings above and any other setting. Edits apply at once, except
  // `exec_interactivity` (next connect) and `default_namespace` (new sessions). Example:
  //
