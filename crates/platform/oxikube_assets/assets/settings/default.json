// Oxikube default settings.
//
// Do not edit this file: it is embedded in the binary. Copy the settings you want to change
// into your user settings.json (`$OXIKUBE_CONFIG_DIR/settings.json`, or
// `~/.config/oxikube/settings.json`) and edit them there. User values override these defaults,
// and `"clusters": { "<cluster id>": { ... } }` overrides both for one cluster.
//
// Every setting a crate registers has its default here (and a schema entry in
// settings.schema.json, regenerated with `cargo xtask gen-settings-schema`).
{
  // Colour theme: a theme name ("Ayu Dark"), or a mode with a light and a dark theme.
  // `mode` is "system" (follow the OS appearance), "light" or "dark". Themes are Zed
  // theme-family JSON: One Dark and One Light are built in; drop more into the `themes/`
  // folder next to settings.json and they are picked up without a restart.
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  // UI zoom factor, 1.0 = 100 %. Clamped to 0.5 - 3.0. cmd/ctrl + and - and 0 change it and
  // write it back here.
  "ui_scale": 1.0,
  // Reduced motion: "system" follows the OS preference, "on" or "off" overrides it.
  "reduce_motion": "system",
  // Ask before quitting while exec sessions, port-forwards or applies are running.
  "confirm_quit": true,
  // Log filter, `RUST_LOG` syntax. Logs go to rolling files in `<data dir>/oxikube/logs`
  // (daily, seven kept) with secrets redacted; a `RUST_LOG` set at launch wins for that run.
  // Keep hyper, h2, tower and rustls at `warn`: at debug and trace they log request headers.
  "log": {
    "filter": "info,hyper=warn,hyper_util=warn,h2=warn,tower=warn,tower_http=warn,rustls=warn"
  },
  // Per-cluster overrides, keyed by cluster id. Each value takes any of the settings above.
  "clusters": {}
}
