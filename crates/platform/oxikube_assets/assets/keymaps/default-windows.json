// Oxikube default keymap (Windows).
//
// Do not edit this file: it is embedded in the binary. Put your own bindings in
// `keymap.json` next to `settings.json` (`$OXIKUBE_CONFIG_DIR`, or `~/.config/oxikube`); they
// layer on top of this file. The format is Zed's: a list of sections, each with an optional
// `context`, an optional `use_key_equivalents`, and `bindings` mapping keystrokes to an action
// name (`"namespace::Name"`), an action with data (`["namespace::Name", { ... }]`) or `null`
// to unbind the key.
//
// An entry whose action no crate has registered is skipped silently: the crate that owns the
// action may not be part of this build.
[
  {
    "bindings": {
      "ctrl-q": "app::Quit",
      "ctrl-,": "oxikube::OpenPreferences",
      "ctrl-shift-p": "palette::Toggle",
      "ctrl-shift-n": "window::New",
      "ctrl-=": "view::ZoomIn",
      "ctrl-+": "view::ZoomIn",
      "ctrl--": "view::ZoomOut",
      "ctrl-0": "view::ZoomReset"
    }
  },
  {
    // Cluster tabs (E06-S04): the nth cluster tab, and cycling through them. `cmd-w` (or
    // `ctrl-w`) closes the displayed one, through `workspace::CloseActiveItem`.
    "bindings": {
      "ctrl-1": ["cluster::SwitchTab", { "index": 1 }],
      "ctrl-2": ["cluster::SwitchTab", { "index": 2 }],
      "ctrl-3": ["cluster::SwitchTab", { "index": 3 }],
      "ctrl-4": ["cluster::SwitchTab", { "index": 4 }],
      "ctrl-5": ["cluster::SwitchTab", { "index": 5 }],
      "ctrl-6": ["cluster::SwitchTab", { "index": 6 }],
      "ctrl-7": ["cluster::SwitchTab", { "index": 7 }],
      "ctrl-8": ["cluster::SwitchTab", { "index": 8 }],
      "ctrl-9": ["cluster::SwitchTab", { "index": 9 }],
      "ctrl-tab": "cluster::NextTab",
      "ctrl-shift-tab": "cluster::PreviousTab"
    }
  },
  {
    // The cluster catalog home (E06-S03). Up and down also work inside its search field, where
    // the text field would otherwise keep them (`Catalog > Input` is as deep as the field's own
    // bindings, and the later binding wins).
    "context": "Catalog",
    "bindings": {
      "up": "catalog::SelectPrevious",
      "down": "catalog::SelectNext",
      "ctrl-p": "catalog::SelectPrevious",
      "ctrl-n": "catalog::SelectNext",
      "ctrl-d": "catalog::ToggleFavouriteSelected",
      "ctrl-shift-d": "catalog::DisconnectSelected"
    }
  },
  {
    "context": "Catalog > Input",
    "bindings": {
      "up": "catalog::SelectPrevious",
      "down": "catalog::SelectNext"
    }
  },
  {
    "context": "Catalog && !Input",
    "bindings": {
      "enter": "catalog::ConnectSelected",
      "home": "catalog::SelectFirst",
      "end": "catalog::SelectLast",
      "/": "catalog::FocusSearch"
    }
  },
  {
    // Resource tables (E07-S03): move the cursor and the selection, select all, copy the name.
    "context": "Table",
    "bindings": {
      "down": "resource_table::SelectNext",
      "up": "resource_table::SelectPrevious",
      "shift-down": "resource_table::ExtendNext",
      "shift-up": "resource_table::ExtendPrevious",
      "home": "resource_table::SelectFirst",
      "end": "resource_table::SelectLast",
      "pagedown": "resource_table::SelectPageDown",
      "pageup": "resource_table::SelectPageUp",
      "ctrl-a": "resource_table::SelectAll",
      "ctrl-c": "resource_table::CopyName"
    }
  },
  {
    // Bare keys stay off while a text field inside the table (its filter) has the focus.
    "context": "Table && !Editing",
    "bindings": {
      "j": "resource_table::SelectNext",
      "k": "resource_table::SelectPrevious",
      "shift-j": "resource_table::ExtendNext",
      "shift-k": "resource_table::ExtendPrevious",
      "enter": "resource_table::OpenSelected",
      "escape": "resource_table::ClearSelection",
      "delete": "resource_table::DeleteSelected",
      // k9s: ctrl-d deletes the selection (the same delete dialog, never a silent delete).
      "ctrl-d": "resource_table::DeleteSelected",
      // k9s: s opens a shell in the pod, a attaches to it (Pods only; a read-only cluster blocks
      // both unless `exec_in_read_only` is on).
      "s": "resource_table::ShellSelected",
      "a": "resource_table::AttachSelected",
      "/": "resource_table::FocusFilter"
    }
  },
  {
    // The table's filter field has the focus: escape clears the filter and returns to the rows
    // (enter returns without clearing; the field handles it).
    "context": "Table && Editing",
    "bindings": {
      "escape": "resource_table::ClearFilter"
    }
  },
  {
    // Log views (E08-S02), k9s's keys: 0 tail, 1 head, 2-6 since 1m / 5m / 15m / 30m / 1h,
    // s autoscroll, w wrap, t timestamps, j JSON mode (E08-S05), p previous container, f fullscreen,
    // m mark, c copy (the selected lines, else the lines on screen), shift-c clear, ctrl-s save the
    // whole buffer to a file, ctrl-shift-s save the lines on screen, escape drops the selection
    // (E08-S06), a send the same lines to the agent (E08-S09). Bare keys stay off while a text field
    // inside the view has the focus. Rebind in
    // keymap.json, e.g. { "context": "LogView && !Editing", "bindings": { "w": null, "x": "log_view::ToggleWrap" } }.
    "context": "LogView && !Editing",
    "bindings": {
      "0": "log_view::Tail",
      "1": "log_view::Head",
      "2": "log_view::Since1m",
      "3": "log_view::Since5m",
      "4": "log_view::Since15m",
      "5": "log_view::Since30m",
      "6": "log_view::Since1h",
      "s": "log_view::ToggleAutoscroll",
      "w": "log_view::ToggleWrap",
      "t": "log_view::ToggleTimestamps",
      "j": "log_view::ToggleJsonMode",
      "p": "log_view::TogglePrevious",
      "f": "log_view::ToggleFullscreen",
      "m": "log_view::Mark",
      "c": "log_view::Copy",
      "a": "log_view::SendToAgent",
      "shift-c": "log_view::Clear",
      "ctrl-s": "log_view::SaveAll",
      "ctrl-shift-s": "log_view::SaveVisible",
      "escape": "log_view::ClearSelection",
      // After the stream stopped (E08-S07): reconnect, or follow the pod that replaced this one.
      "r": "log_view::Reconnect",
      "shift-r": "log_view::FollowReplacement",
      // Search (E08-S03): `/` opens the bar (k9s), `n` / `N` step through the matches.
      "/": "log_view::Find",
      "n": "log_view::NextMatch",
      "shift-n": "log_view::PreviousMatch"
    }
  },
  {
    // Open the search from anywhere in the log view, the field included.
    "context": "LogView",
    "bindings": {
      "ctrl-f": "log_view::Find"
    }
  },
  {
    // While the bar is open (enter / shift-enter step through the matches in the field itself):
    // escape closes it, and alt-c / alt-i / alt-f toggle case, inverse and filter mode.
    "context": "LogView && searching",
    "bindings": {
      "escape": "log_view::CloseSearch",
      "alt-c": "log_view::ToggleCase",
      "alt-i": "log_view::ToggleInverse",
      "alt-f": "log_view::ToggleFilterMode"
    }
  },
  {
    // Terminals (E09-S07): ctrl-` shows (and focuses) the shown cluster's terminal panel in the
    // bottom dock or hides it; ctrl-~ opens a new shell there (a plain shell tab when no cluster
    // tab is shown).
    "bindings": {
      "ctrl-`": "terminal_panel::TogglePanel",
      "ctrl-~": "terminal::New"
    }
  },
  {
    // Terminal (E09-S06): ctrl-shift-c copies the selection, ctrl-shift-v (or shift-insert) pastes
    // (a multi-line paste asks first, `terminal.confirm_multiline_paste`). ctrl-c is never
    // bound: it always reaches the process as an interrupt. Every other key goes to the process
    // (see the mapping in `oxikube_terminal::mappings`).
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-shift-v": "terminal::Paste",
      "shift-insert": "terminal::Paste",
      // E09-S07: ctrl-shift-w closes the focused terminal (in a pane or the bottom dock),
      // ctrl-shift-d opens a terminal running the same shell in a new pane to the right.
      "ctrl-shift-w": "terminal::Close",
      "ctrl-shift-d": "terminal::Split"
    }
  }
]
