+
+    const REFRESH: Duration = Duration::from_micros(8_333);
+
+    #[test]
+    fn a_resize_a_refresh_after_the_last_frame_is_drawn_at_once() {
+        let last = Instant::now();
+        assert!(frame_due_at(true, Some(REFRESH), Some(last), last + REFRESH));
+        assert!(frame_due_at(true, Some(REFRESH), Some(last), last + REFRESH * 2));
+    }
+
+    #[test]
+    fn an_early_resize_waits_for_the_display_pass() {
+        let last = Instant::now();
+        let early = last + REFRESH - Duration::from_micros(1);
+        assert!(!frame_due_at(true, Some(REFRESH), Some(last), early));
+        assert!(!frame_due_at(true, Some(REFRESH), Some(last), last));
+    }
+
+    #[test]
+    fn a_hidden_window_or_an_unknown_refresh_never_draws_early() {
+        let last = Instant::now();
+        let late = last + REFRESH * 3;
+        assert!(!frame_due_at(false, Some(REFRESH), Some(last), late));
+        assert!(!frame_due_at(true, None, Some(last), late));
+        assert!(!frame_due_at(true, Some(REFRESH), None, late));
+    }
+}
