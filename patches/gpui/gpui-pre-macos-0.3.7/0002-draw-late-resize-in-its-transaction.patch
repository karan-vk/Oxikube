+    /// The refresh interval of the display this source was last started on: the display link's
+    /// measured period, else its nominal one. `None` before the first start.
+    pub fn refresh_interval(&self) -> Option<Duration> {
+        let display_id = self.display_id?;
+        // Cloned under the lock, queried outside it (see the lock ordering note above).
+        let mut link = lock_registry()
+            .displays
+            .get(&display_id)
+            .map(|entry| entry.link.clone())?;
+        let seconds = unsafe { link.refresh_period() };
+        (seconds > 0.0).then(|| Duration::from_secs_f64(seconds))
+    }
