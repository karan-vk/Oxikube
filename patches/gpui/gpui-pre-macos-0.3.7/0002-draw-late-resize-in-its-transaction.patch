+/// Whether a refresh or more has passed since the window last asked for a frame.
+fn frame_is_due(state: &MacWindowState) -> bool {
+    let visible = unsafe {
+        state
+            .native_window
+            .occlusionState()
+            .contains(NSWindowOcclusionState::NSWindowOcclusionStateVisible)
+    };
+    let interval = state
+        .frame_source
+        .as_ref()
+        .and_then(WindowFrameSource::refresh_interval);
+    frame_due_at(visible, interval, state.last_frame_request, Instant::now())
+}
+
+/// [`frame_is_due`]'s rule: a visible window whose last frame request is at least one refresh
+/// interval old. Without a known interval or a previous request, the display pass decides.
+fn frame_due_at(
+    visible: bool,
+    interval: Option<Duration>,
+    last_request: Option<Instant>,
+    now: Instant,
+) -> bool {
+    match (visible, interval, last_request) {
+        (true, Some(interval), Some(last)) => now.saturating_duration_since(last) >= interval,
+        _ => false,
+    }
+}
